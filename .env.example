# Copy to .env and fill in. NEVER commit .env.
# Generate secrets with:  openssl rand -hex 32
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-16
JWT_SECRET=change-me-must-be-at-least-32-characters-long
ANTHROPIC_API_KEY=sk-ant-your-key-here
MODEL=claude-sonnet-5-5

# Demo users (admin@demo.local, manager@..., rep@..., viewer@...). LOCAL DEV ONLY.
SEED_DEMO_USERS=true
DEMO_PASSWORD=ChangeMe-Demo-123

# Which CSV folder to load. data/sample = tiny synthetic stand-in; data/maven = real dataset.
CRM_DATA_DIR=./data/sample

# Optional: Slack-compatible incoming webhook, called when a deal is marked Won
SLACK_WEBHOOK_URL=
